{
    '$schema': 'https://docs.renovatebot.com/renovate-schema.json',
    'extends': ['github>Lombiq/renovate-config:default-orchard-core-submodule.json5'],
    "packageRules": [
        {
            groupName: 'Gulp packages',
            matchPackageNames: [
                'chart.js*',
            ],
        },
        {
            "groupName": "All packages",
            "matchUpdateTypes": ["*"],
        },
    ]
}
